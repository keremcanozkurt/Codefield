# Optional. Raises the GitHub API rate limit for repository requests.
# Read on the server only. Public repositories work without it.
# A token with read-only access to public repositories is enough.
# It is never used to read private repositories.
GITHUB_TOKEN=

# Optional. Private repository access through a GitHub App. All four must be
# set, or private access stays off. See "Private repositories" in README.md.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# At least 32 characters, for example from `openssl rand -base64 32`.
# Encrypts the session cookie; changing it disconnects every browser.
GITHUB_SESSION_SECRET=
